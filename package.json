{
  "name": "concrete-encased-rectangular-composite-column",
  "private": true,
  "version": "1.0.0",
  "description": "IS 11384:2022 CCD Example 001 — concrete-encased rectangular composite column: compression, moment, shear and demand/capacity verification (web + desktop app).",
  "author": "6thsuspect",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "cross-env ELECTRON=1 vite",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run build && electron-builder",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "org.is11384.cecc",
    "productName": "IS 11384 CECC Designer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.engineering"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Engineering"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
